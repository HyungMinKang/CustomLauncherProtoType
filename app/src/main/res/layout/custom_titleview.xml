<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 타이틀 텍스트 -->
    <TextView
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:padding="16dp"
        android:visibility="visible"
        android:text="MZB STB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Content"
        android:id="@+id/content_tv"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:background="@drawable/focus_selector"
        app:layout_constraintLeft_toRightOf="@id/title_tv"
        app:layout_constraintTop_toTopOf="@id/title_tv"
        android:nextFocusRight="@id/setting_tv"
        android:padding="8dp"
        android:nextFocusDown="@id/weather_card"
        android:drawableStart="@drawable/ic_baseline_play_arrow_24"
        app:layout_constraintBottom_toBottomOf="@id/title_tv"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setting"
        android:nextFocusLeft="@id/content_tv"
        android:nextFocusRight="@id/ott_tv"
        android:padding="8dp"
        android:nextFocusDown="@id/weather_card"
        android:id="@+id/setting_tv"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:background="@drawable/focus_selector"
        app:layout_constraintLeft_toRightOf="@id/content_tv"
        app:layout_constraintTop_toTopOf="@id/title_tv"
        android:layout_marginLeft="30dp"
        android:drawableStart="@drawable/ic_baseline_play_arrow_24"
        app:layout_constraintBottom_toBottomOf="@id/title_tv"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OTT"
        android:id="@+id/ott_tv"
        android:focusable="true"
        android:padding="8dp"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:nextFocusLeft="@id/setting_tv"
        android:nextFocusRight="@id/content_tv"
        android:nextFocusDown="@id/weather_card"
        android:background="@drawable/focus_selector"
        app:layout_constraintLeft_toRightOf="@id/setting_tv"
        app:layout_constraintTop_toTopOf="@id/title_tv"
        android:layout_marginLeft="30dp"
        app:layout_constraintBottom_toBottomOf="@id/title_tv"
        android:drawableStart="@drawable/ic_baseline_play_arrow_24"
        />

    <!-- 시계 (선택사항) -->
    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title_tv"
        app:layout_constraintBottom_toBottomOf="@id/title_tv"
        android:layout_marginEnd="40dp"
        android:text="12:00" />


    <LinearLayout
        android:id="@+id/led_control_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@id/title_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <Button
            android:id="@+id/btn_red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/btn_green" />

        <Button
            android:id="@+id/btn_green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_red"
            android:nextFocusRight="@id/btn_blue" />

        <Button
            android:id="@+id/btn_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_green"
            android:nextFocusRight="@id/btn_brightness" />

        <Button
            android:id="@+id/btn_brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="밝기"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_blue"
            android:nextFocusRight="@id/btn_white" />

        <Button
            android:id="@+id/btn_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHITE"

            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_brightness"
            android:nextFocusRight="@id/tv_adc_value" />

        <TextView
            android:id="@+id/tv_adc_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADC: ---"
            android:textSize="16sp"
            android:layout_marginStart="10dp"
            android:textColor="@android:color/white"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_white"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>